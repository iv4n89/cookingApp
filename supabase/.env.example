# Credenciales OAuth para el login social (Supabase Auth).
# Copia a supabase/.env y expórtalas antes de `supabase start`
# (o `set -a; source supabase/.env; set +a`). NO commitear supabase/.env.

# Google Cloud -> APIs y servicios -> Credenciales -> ID de cliente de OAuth (tipo "Aplicación web").
# Orígenes autorizados: http://127.0.0.1:54321
# URI de redirección autorizado: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
