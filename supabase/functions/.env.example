# Clave de Google Gemini (AI Studio: https://aistudio.google.com/apikey)
# Copia este archivo a supabase/functions/.env (ignorado por git) y pon tus valores.
GEMINI_API_KEY=tu-clave-de-gemini

# Secreto para invocar endpoints internos (index-recipe). Cualquier cadena larga.
INTERNAL_FUNCTION_SECRET=un-secreto-largo-aleatorio

# Búsqueda web para atribución de recetas (Tavily: https://tavily.com). Opcional:
# sin ella, la generación sigue funcionando sin atribución (source='generated').
TAVILY_API_KEY=tvly-tu-clave

