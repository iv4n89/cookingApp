# Supabase local (supabase start imprime estos valores)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Acceso opcional para desarrollo local. Usa un usuario de prueba de Supabase local;
# este archivo solo documenta los nombres y no debe contener credenciales reales.
EXPO_PUBLIC_DEV_LOGIN_EMAIL=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=
