{
  "name": "recetas-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mobile": "pnpm --filter @recetas/mobile",
    "api": "pnpm --filter @recetas/api",
    "lint": "eslint apps packages",
    "typecheck": "pnpm --filter @recetas/mobile exec tsc --noEmit -p tsconfig.json && pnpm --filter @recetas/shared exec tsc --noEmit -p tsconfig.json && pnpm --filter @recetas/theme exec tsc --noEmit -p tsconfig.json",
    "validate:expiration-profiles": "node scripts/validate-expiration-profiles.mjs",
    "test:db": "supabase test db --local supabase/tests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
